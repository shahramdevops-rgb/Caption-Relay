{
  "manifest_version": 3,
  "name": "CaptionRelay",
  "version": "0.1.0",
  "description": "Receives Live Captions text from the CaptionRelay Windows app and submits it in your chat tab (Gemini).",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "providers/gemini/selectors.js",
        "providers/webchat.js",
        "providers/gemini/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CaptionRelay",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
