<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev tool: records real Live Captions snapshots to a JSONL fixture for TranscriptMerger replay tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\app\CaptionRelay.csproj" />
  </ItemGroup>

</Project>
